POSTGRES_DB=sweet_shop
POSTGRES_USER=sweet_shop
POSTGRES_PASSWORD=replace_for_non_local_use
DATABASE_URL=postgresql+psycopg://sweet_shop:replace_for_non_local_use@db:5432/sweet_shop
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Оставьте legacy до импорта JSON и переключения CRM на PostgreSQL.
ORDER_BACKEND=legacy
CRM_BACKEND=legacy
API_INTERNAL_URL=http://api:8000
APP_ENVIRONMENT=local
APP_VERSION=0.8.0
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_at_least_12_characters
ADMIN_FULL_NAME=Администратор
