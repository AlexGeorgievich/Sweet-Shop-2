# Токен выдаёт официальный бот @BotFather. Никому не публикуйте настоящий токен.
TELEGRAM_BOT_TOKEN=1234567890:replace_with_your_bot_token

# ID личного чата или закрытой группы, куда будут приходить заявки.
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Необязательно: ID темы, если заявки отправляются в тему Telegram-группы.
TELEGRAM_MESSAGE_THREAD_ID=

# Секрет проверки запросов от Telegram webhook. Сгенерируйте случайную строку.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# LLM Router: ключ хранится только в .env.local.
LLM_ROUTER_API_KEY=replace_with_your_llm_router_key
LLM_ROUTER_BASE_URL=https://llm-router.org/v1
LLM_ROUTER_MODEL=gemini-3-flash

# Адрес сайта, который бот отправляет покупателю для оформления заявки.
SITE_URL=http://localhost:3000

# Внутренний мост long polling к локальному обработчику.
LOCAL_TELEGRAM_WEBHOOK_URL=http://127.0.0.1:3000/api/telegram/webhook
